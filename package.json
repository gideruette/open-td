{
  "name": "open-td",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-build-info.mjs",
    "start": "ng serve open-td",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "ng build shared && ng build engine && ng build open-td",
    "prebuild:app": "node scripts/generate-build-info.mjs",
    "build:app": "ng build open-td",
    "prewatch": "node scripts/generate-build-info.mjs",
    "watch": "ng build open-td --watch --configuration development",
    "test": "ng test open-td",
    "test:engine": "ng test engine",
    "test:shared": "ng test shared",
    "prebalance": "ng build shared && ng build engine",
    "balance": "node --import ./scripts/register-workspace.mjs ./scripts/balance-campaign.mjs"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "@types/luxon": "^3.7.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
